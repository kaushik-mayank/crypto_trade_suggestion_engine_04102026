# crypto_trader environment - template (committed). Copy to `.env` and fill in the values.
# `.env` is gitignored and must never be committed (CLAUDE.md invariant 10).
#
# These are the ONLY two variables the code reads (src/cdx_http/signed.py).
# Everything else in this project uses public endpoints and needs no key.
#
# Create the key at CoinDCX -> API Dashboard. Give it READ-ONLY access:
#   - NO trading permission
#   - NO withdrawal / transfer permission
# (CLAUDE.md invariant 11: nothing in this codebase may place, cancel or transfer anything.)
#
# Used by:
#   - probe P8          : python -m probes.p08_positioning
#   - recorder stream S2: positioning (futures data/stats), enabled in recorder.toml after P8 passes
#
# Format: KEY=value, no spaces around '=', no quotes needed. A value may be wrapped in
# single or double quotes; they are stripped. Leave a value empty to disable signed calls.
# A process environment variable of the same name overrides the file.

# Public API key (the "API Key" string shown by CoinDCX). Sent as the X-AUTH-APIKEY header.
COINDCX_API_KEY=

# API secret (shown once when the key is created). Never sent; used only to compute the
# HMAC-SHA256 request signature (X-AUTH-SIGNATURE).
COINDCX_API_SECRET=
