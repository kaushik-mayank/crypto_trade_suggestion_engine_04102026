# Copy to .env.local for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables.
#
# BOTH are server-side only. Neither has the NEXT_PUBLIC_ prefix, which is deliberate:
# a NEXT_PUBLIC_ variable is compiled into the JavaScript the browser downloads, so the token
# would be readable by anyone who opened the page. These are read only inside the proxy route,
# which runs on Vercel's server.

# Where the Azure VM's API is reachable. With a Cloudflare tunnel this is the tunnel's URL.
CT_API_BASE=https://your-tunnel-name.trycloudflare.com

# Must match CT_SERVER__AUTH_TOKEN on the VM exactly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CT_API_TOKEN=
